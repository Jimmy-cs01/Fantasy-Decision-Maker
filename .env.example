NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Canonical production origin. For local development, change this to
# http://localhost:3000 or http://localhost:3001.
NEXT_PUBLIC_SITE_URL=https://jimmygm.com

# Only required for trusted server jobs that must bypass RLS. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only explicit production projection version. Newer experimental rows
# never become active merely because they have a later generated_at timestamp.
ACTIVE_PROJECTION_MODEL_VERSION=v2

# Optional server-only Vegas enrichment. Never prefix this with NEXT_PUBLIC_.
ODDS_API_KEY=

# Yahoo Fantasy OAuth (server-only). Register exact callback URLs in Yahoo.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/yahoo/callback
# 32 random bytes encoded as 64 hex characters or base64.
YAHOO_TOKEN_ENCRYPTION_KEY=
