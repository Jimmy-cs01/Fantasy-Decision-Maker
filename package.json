{
  "name": "fantasy-decision-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:download": "python3 scripts/download_nflverse_player_stats.py",
    "data:match": "python3 scripts/match_sleeper_players.py",
    "data:build": "python3 scripts/build_historical_weekly_stats.py",
    "data:schedules": "python3 scripts/download_nflverse_schedules.py",
    "data:schedules:import:dry-run": "python3 scripts/import_nfl_schedules.py --season 2026 --dry-run",
    "data:schedules:import": "python3 scripts/import_nfl_schedules.py --season 2026",
    "data:odds:sync": "vite-node scripts/sync_the_odds_api.ts",
    "data:depth-charts": "python3 scripts/download_nflverse_depth_charts.py",
    "data:depth-charts:import:dry-run": "python3 scripts/import_depth_charts.py --dry-run",
    "data:players": "python3 scripts/download_nflverse_players.py",
    "data:players:import:dry-run": "python3 scripts/import_player_draft_capital.py --dry-run",
    "data:import:dry-run": "python3 scripts/import_historical_data.py --dry-run",
    "projection:features": "python3 scripts/build_projection_dataset.py",
    "projection:train": "python3 scripts/train_projection_model.py --version v2",
    "projection:evaluate": "python3 scripts/evaluate_projection_model.py --version v2",
    "projection:generate": "python3 scripts/generate_weekly_projections.py",
    "projections:reconcile": "vite-node scripts/reconcile_weekly_projections.ts",
    "projections:audit": "vite-node scripts/audit_projections.ts",
    "value:calibrate": "python3 scripts/calibrate_player_values.py",
    "value:archetypes": "vite-node scripts/report_player_value_archetypes.ts",
    "trade:benchmark": "vite-node scripts/benchmark_trade_finder.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
